# ============================================================
# Aruk — Keeper of Secrets and Keys
# Environment Configuration (Web / Next.js)
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Docker deployment, see docker/docker-compose.yml
# ============================================================

# ─── Database ────────────────────────────────────────────────
# SQLite file path. In dev, a local file is fine.
# In production (Docker), the path is /app/data/aruk.db
DATABASE_URL=file:./dev.db

# ─── Next.js ─────────────────────────────────────────────────
# The URL of your Aruk deployment (used by next-auth and redirects)
NEXTAUTH_URL=http://localhost:3000

# Secret used to encrypt/decrypt next-auth sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# ─── Server ──────────────────────────────────────────────────
# Port the Next.js server listens on (default: 3000)
PORT=3000

# ─── API Bank ────────────────────────────────────────────────
# Base URL that the CLI / SDK point at.
# Usually the same as NEXTAUTH_URL for a single deployment.
APIBANK_URL=http://localhost:3000

# ─── Authentication (Optional) ───────────────────────────────
# If you want to protect the API with a token, set this and check
# it in your API routes. The SDK / CLI will send it as a Bearer token.
NEXT_PUBLIC_ARUK_TOKEN=
