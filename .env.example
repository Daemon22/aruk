# Aruk — Environment Configuration

# Local development uses SQLite. For hosted deployments, use Neon Postgres.
DATABASE_URL="file:./db/custom.db"
# Neon runtime URL: use the pooled connection string from the Neon dashboard.
# Keep this value server-side; never use a NEXT_PUBLIC_ prefix.
# DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
# Neon direct URL: use the non-pooled connection string for Prisma migrations.
# DIRECT_URL="postgresql://.../neondb?sslmode=require"

# Generate independent random values with: openssl rand -hex 32
BETTER_AUTH_SECRET=
ARUK_ENCRYPTION_KEY=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins allowed to use the auth API.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Single browser origin allowed by Aruk's API CORS headers.
ARUK_CORS_ORIGIN=http://localhost:3000

# Optional OAuth. Configure matching callback URLs in Google/GitHub:
# http://localhost:3000/api/auth/callback/google
# http://localhost:3000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email verification and account recovery. In development without Resend,
# one-time URLs are printed to the local server terminal.
RESEND_API_KEY=
EMAIL_FROM=

# Keep disabled outside local development.
ARUK_BYPASS_AUTH=false

ARUK_ORIGIN_NAME=Azura Daemon
