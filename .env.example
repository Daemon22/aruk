# Aruk — Environment Configuration

# Local app storage. Keep SQLite for an offline desktop install.
# For a hosted Aruk deployment, use the Supabase Postgres connection string.
DATABASE_URL="file:./db/custom.db"

# Supabase project: use the publishable key in browser code and keep secret keys server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also accepted during migration.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required only for server-side account deletion. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service-role key is accepted; prefer the secret key above.
SUPABASE_SERVICE_ROLE_KEY=

# Generate each with: openssl rand -hex 32
ARUK_SESSION_SECRET=
ARUK_ENCRYPTION_KEY=

# Local self-hosted sign-up is enabled as requested. Hosted sign-up is controlled in Supabase Auth.
ARUK_ALLOW_PUBLIC_SIGNUP=true
ARUK_BYPASS_AUTH=false

ARUK_ORIGIN_NAME=Azura Daemon
# Separate origins with commas. Localhost and 127.0.0.1 are both accepted in development.
ARUK_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Backward-compatible single-origin setting.
ARUK_CORS_ORIGIN=http://localhost:3000
