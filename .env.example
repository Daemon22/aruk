# Aruk — Environment Configuration
# Copy this to .env and fill in real values before deploying.

# Database (SQLite)
DATABASE_URL="file:./db/custom.db"

# ── Recommended for production ──────────────────────────────
# Session-signing secret and vault encryption key.
# Production requires both values explicitly. Local development can
# generate and persist them beside the SQLite database.
# Generate each with: openssl rand -hex 32
ARUK_SESSION_SECRET=
ARUK_ENCRYPTION_KEY=

# Leave public self-service account creation disabled. This version
# does not yet implement email verification, recovery, or MFA.
ARUK_ALLOW_PUBLIC_SIGNUP=false

# ── Development only ─────────────────────────────────────────
# Skips auth entirely and uses a single local "dev" user.
# NEVER set this to true in production.
ARUK_BYPASS_AUTH=false

# Named sovereign Origin for this Aruk deployment
ARUK_ORIGIN_NAME=Azura Daemon

# Explicit browser origin allowed to call the API (do not use * for credentialed APIs)
ARUK_CORS_ORIGIN=http://localhost:3000
