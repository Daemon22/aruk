# Aruk — Environment Configuration

# Local development uses SQLite. For hosted deployments, use Neon Postgres.
DATABASE_URL="file:./db/custom.db"
# Neon runtime URL: use the pooled connection string from the Neon dashboard.
# Keep this value server-side; never use a NEXT_PUBLIC_ prefix.
# DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
# Neon direct URL: use the non-pooled connection string for Prisma migrations.
# DIRECT_URL="postgresql://.../neondb?sslmode=require"

# Generate independent random values with: openssl rand -hex 32
BETTER_AUTH_SECRET=
ARUK_ENCRYPTION_KEY=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins allowed to use the auth API.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Single browser origin allowed by Aruk's API CORS headers.
ARUK_CORS_ORIGIN=http://localhost:3000

# Account email delivery. Aruk owns account creation; the selected provider only transports mail.
# EMAIL_PROVIDER=resend uses RESEND_API_KEY. EMAIL_PROVIDER=postmark uses POSTMARK_SERVER_TOKEN.
# If omitted, Aruk auto-selects Postmark when only POSTMARK_SERVER_TOKEN is set, otherwise Resend.
EMAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
# Required in production and for Postmark. Use a sender on a domain verified with the provider.
EMAIL_FROM=
# Optional Postmark message stream; defaults to outbound.
POSTMARK_MESSAGE_STREAM=

# Optional social sign-in providers. Both values must be set for a provider to appear.
# Google callback: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keep disabled outside local development.
ARUK_BYPASS_AUTH=false

ARUK_ORIGIN_NAME=Azura Daemon
