# ============================================================
# Aruk — Root .gitignore
# ============================================================

# ─── Node / Bun / Package Managers ───────────────────────────
node_modules/
node_modules
.npm
.pnpm-store
.bun
.bun-cache/
bun.lockb
yarn.lock
# (bun.lock is tracked intentionally for Tauri/Docker reproducibility)

# ─── Next.js / Web Build Outputs ───────────────────────────
.next/
out/
.nuxt/
.dist/

# ─── Tauri / Rust Build Outputs ────────────────────────────
src-tauri/target/
target/
*.exe
*.app
*.msi
*.dmg

# ─── Prisma (generated client) ───────────────────────────────
web/prisma/generated/
web/node_modules/.prisma/
*-prisma

# ─── Database / Local Data ───────────────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3
aruk.db
dev.db
*.db-shm
*.db-wal
data/
*.data

# ─── Environment ─────────────────────────────────────────────
.env
.env.local
.env.development
.env.test
.env.production
# (env.example files are tracked)

# ─── OS / Editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
*.ipr
*.iws
.history/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Android ─────────────────────────────────────────────────
.android/
.local/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.ap_
*.aab
.gradle/

# ─── Misc ────────────────────────────────────────────────────
.tmp/
.tmp/
temp/
*.tmp
dist/
build/
.nyc_output/
coverage/
```
